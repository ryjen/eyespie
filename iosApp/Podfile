platform :ios, '15.0'

source 'https://cdn.cocoapods.org'

repo_root = File.expand_path('..', __dir__)
model_stager = File.join(repo_root, 'scripts', 'stage_image_embedder_model.py')
unless system('python3', model_stager, 'stage', '--target', 'ios')
  raise 'Failed to stage the pinned Eyespie image-embedder model'
end

fixture_stager = File.join(repo_root, 'scripts', 'stage_image_embedding_fixtures.py')
unless system('python3', fixture_stager, 'stage', '--target', 'ios')
  raise 'Failed to stage the pinned Eyespie image-embedding calibration fixtures'
end

target 'iosApp' do
  use_frameworks! :linkage => :static

  # Keep these direct podspec sources aligned with the Kotlin CocoaPods dependency graph.
  pod 'EyespieMediaPipeTasksCommon', :podspec => 'MediaPipePodspecs/EyespieMediaPipeTasksCommon.podspec'
  pod 'EyespieMediaPipeTasksVision', :podspec => 'MediaPipePodspecs/EyespieMediaPipeTasksVision.podspec'
  pod 'EyespieMediaPipeTasksGenAIC', :podspec => 'MediaPipePodspecs/EyespieMediaPipeTasksGenAIC.podspec'
  pod 'EyespieMediaPipeTasksGenAI', :podspec => 'MediaPipePodspecs/EyespieMediaPipeTasksGenAI.podspec'
  pod 'EyespieImageEmbedderModel', :path => 'ModelArtifacts'
  pod 'EyespieImageEmbeddingCalibrationFixtures', :path => 'CalibrationFixtures', :configurations => ['Debug']

  pod 'eyespie', :path => '../eyespie'
end

post_install do |installer|
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_targets.each do |user_target|
      next unless user_target.name == 'iosApp'

      phase_name = 'Verify Eyespie Image Embedder Model'
      user_target.shell_script_build_phases
        .select { |phase| phase.name == phase_name }
        .each { |phase| user_target.build_phases.delete(phase) }

      phase = user_target.new_shell_script_build_phase(phase_name)
      phase.shell_path = '/bin/bash'
      phase.shell_script = <<-'SCRIPT'
set -euo pipefail
repo_root="${SRCROOT}/.."
model_name="mobilenet_v3_small_100_224_embedder.tflite"
resource_root="${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}"
match_count="$(find "$resource_root" -type f -name "$model_name" -print | wc -l | tr -d ' ')"
if [[ "$match_count" != "1" ]]; then
  printf 'error: expected exactly one packaged image embedder, found %s\n' "$match_count" >&2
  find "$resource_root" -type f -name "$model_name" -print >&2 || true
  exit 1
fi
model_path="$(find "$resource_root" -type f -name "$model_name" -print -quit)"
python3 "$repo_root/scripts/stage_image_embedder_model.py" verify-file "$model_path"
SCRIPT
      user_target.project.save
    end
  end
end
