require 'fileutils'

fastlane_require 'semantic'
fastlane_require 'semantic/core_ext'

platform :android do
  repo_root = File.expand_path('..', __dir__)
  app_gradle_file = File.join(repo_root, 'eyespie', 'build.gradle.kts')
  verification_lanes = [:validate, :test, :bundle_debug].freeze

  before_all do |lane|
    gradle(task: "clean") unless verification_lanes.include?(lane)
  end

  after_all do |lane|
    clean_build_artifacts unless verification_lanes.include?(lane)
  end

  private_lane :prepare_verification_config do
    env_path = File.join(repo_root, '.env.local')
    example_path = File.join(repo_root, 'env.example')
    FileUtils.cp(example_path, env_path) unless File.exist?(env_path)
  end

  desc "Validate model, calibration, and Android bundle contracts"
  lane :validate do
    Dir.chdir(repo_root) do
      sh("python3 scripts/stage_android_model_artifact.py verify")
      sh("python3 scripts/stage_image_embedder_model.py validate-manifest")
      sh("python3 scripts/stage_image_embedding_fixtures.py validate-manifest")
      sh("python3 -m unittest scripts.tests.test_stage_image_embedder_model")
      sh("python3 -m unittest scripts.tests.test_stage_image_embedding_fixtures")
      sh("python3 -m unittest scripts.tests.test_compare_image_embedding_calibration")
      sh("python3 -m unittest scripts.tests.test_validate_android_bundle")
    end
  end

  desc "Run Android unit/snapshot tests and compile physical-device tests"
  lane :test do
    prepare_verification_config
    gradle(
      project_dir: repo_root,
      tasks: [
        ":bluebell:testDebugUnitTest",
        ":app:testDebugUnitTest",
        ":app:assembleDebugAndroidTest"
      ],
      flags: "--no-daemon --parallel --build-cache --configuration-cache"
    )
  end

  desc "Build and verify the debug app bundle and model asset-pack topology"
  lane :bundle_debug do
    prepare_verification_config
    Dir.chdir(repo_root) do
      sh("bash scripts/ci/verify_android_bundle.sh")
    end
  end

  desc "Build Android Debug APK"
  lane :build_debug do
    Dir.chdir(repo_root) do
      sh("python3 scripts/stage_image_embedder_model.py stage --target android")
    end
    gradle(
      task: "assemble",
      build_type: "Debug",
      print_command: false,
      properties: {
        "android.injected.signing.store.file" => ENV["ANDROID_STORE_FILE"],
        "android.injected.signing.store.password" => ENV["ANDROID_STORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"],
      }
    )
  end

  desc "Build Android Release APK"
  lane :build_release do
    Dir.chdir(repo_root) do
      sh("python3 scripts/stage_image_embedder_model.py stage --target android")
    end
    gradle(
      task: "assemble",
      build_type: "Release",
      print_command: false,
      properties: {
        "android.injected.signing.store.file" => ENV["ANDROID_STORE_FILE"],
        "android.injected.signing.store.password" => ENV["ANDROID_STORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"],
      }
    )
  end

  desc "Distribute Android APK to production"
  lane :distribute_production do |options|
    version_code = options[:version_code] || android_get_version_code(
      gradle_file: app_gradle_file
    )

    version_name = options[:version_name] || android_get_version_name(
      gradle_file: app_gradle_file
    )

    upload_to_play_store(
      track: 'beta',
      track_promote_to: 'production',
      version_code: version_code,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false
    )

    add_git_tag(tag: "android-production-#{version_name}")
    push_git_tags
  end

  desc "Distribute Android APK to staging"
  lane :distribute_staging do |options|
    version_code = options[:version_code] || android_get_version_code(
      gradle_file: app_gradle_file
    )

    upload_to_play_store(
      track: 'internal',
      track_promote_to: 'beta',
      version_code: version_code,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false
    )
  end

  desc "Distribute Android APK to development"
  lane :distribute_development do |options|
    version_code = options[:version_code] || android_get_version_code(
      gradle_file: app_gradle_file
    )

    version_name = android_get_version_name(
      gradle_file: app_gradle_file
    )

    android_set_version_code(
      gradle_file: app_gradle_file,
      version_code: version_code.to_i + 1
    )

    build_release

    upload_to_play_store(
      track: 'internal',
      release_status: 'draft',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      version_name: version_name,
      mapping: File.join(repo_root, 'eyespie', 'build', 'outputs', 'mapping', 'release', 'mapping.txt')
    )
  end
end
